<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This repository is a public library and does not depend on corporate feeds.
    The sources below are therefore the only ones used when restoring Miltha.Tech.Core.

    - nuget.org: public packages.
    - local-artifacts: local folder produced by `dotnet pack -o ./artifacts`
      so the packages can be consumed during development before being published.

    The GitHub Packages source is added by the CI workflow, where credentials exist.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-artifacts" value="./artifacts" />
  </packageSources>
</configuration>