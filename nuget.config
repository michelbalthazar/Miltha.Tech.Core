<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Sources are inherited from the machine/user level (nuget.org, corporate feeds).
    This file only adds the local packages folder produced by `dotnet pack -o ./artifacts`
    so the packages can be consumed during development before being published.

    The GitHub Packages source is added by the CI workflow, where credentials exist.
  -->
  <packageSources>
    <add key="local-artifacts" value="./artifacts" />
  </packageSources>
</configuration>
